<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's foreground.

     It matches the desktop icon: a blue annotation stroke across the
     tile, with the red laser pointer beside it.  The vector is drawn
     in a 108dp square, which is the adaptive-icon canvas; the safe
     zone is the middle 72dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The annotation stroke. -->
    <path
        android:pathData="M30,74 C38,56 48,46 60,52 C70,57 76,64 82,66"
        android:strokeColor="#4A9EFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The laser pointer. -->
    <path
        android:pathData="M78,62 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#FF594A" />
</vector>
